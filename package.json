{
  "name": "mars-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mars-blog --local",
    "db:migrate": "wrangler d1 migrations apply mars-blog --remote",
    "db:console": "wrangler d1 execute mars-blog --local --command",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepare": "wrangler types",
    "types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.6",
    "@astrojs/react": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@shikijs/transformers": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "astro": "^7.1.1",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.20",
    "marked": "^18.0.7",
    "react": "^19",
    "react-dom": "^19",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.115.0"
  }
}
