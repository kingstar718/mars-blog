---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/site";

// 公开页面的外壳。搬自旧站的 Layout.astro，去掉了 i18n、sitemap 和
// 站点验证——这些等基础跑顺了再补。RSS 在 2026-08 补了回来（/feed.xml）。
// 字体和防闪烁脚本一字未改，
// 它们是阅读体验里最先被看见的部分。
//
// main 的类名对齐旧站的 Main.astro（app-layout pb-4），上边距由各页面
// 通过 mainClass 自己给——旧站就是这么分工的，首页 pt-8 pb-6，列表页 pt-8。

type Props = {
  title?: string;
  mainClass?: string;
};

const { title = site.title, mainClass = "pt-8" } = Astro.props;
const pageTitle = title === site.title ? title : `${title} · ${site.title}`;
---

<!doctype html>
<html lang={site.lang} class="overflow-y-scroll scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 不声明的话浏览器会自己去要 /favicon.ico，每个页面白挨一个 404 */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/fonts/noto-serif/font.css" />
    <link rel="stylesheet" href="/fonts/noto-serif-sc/font.css" />
    <link rel="stylesheet" href="/fonts/noto-sans-mono/font.css" />

    <title>{pageTitle}</title>
    {
      /* 全站一句，不分页面：文章页不需要自己的描述，
        真要分就得每篇手写一句，那是又一处「要人维护、写错了没人提示」的东西 */
    }
    <meta name="description" content={site.description} />
    <meta name="author" content={site.author} />

    <!--
      防闪烁：必须同步执行，在浏览器绘制之前把 data-theme 写到 <html> 上。
      不能加 defer/async，也不能挪到 body。
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        document.firstElementChild?.setAttribute(
          "data-theme",
          stored ?? (prefersDark ? "dark" : "light")
        );
      })();
    </script>
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground flex min-h-svh flex-col"
  >
    {
      /* 会话检测：登录后给 <html> 挂 data-session，编辑入口（[data-admin]）才显示 */
    }
    <script is:inline>
      (async () => {
        try {
          const response = await fetch("/api/auth/session");
          if (response.ok) document.documentElement.dataset.session = "1";
        } catch {}
      })();
    </script>

    <Header />

    <main id="main-content" class:list={["app-layout pb-4", mainClass]}>
      <slot />
    </main>

    <Footer />

    {
      /* 浏览量客户端上报：服务端渲染时加会把爬虫和预取都算进去。
         带 query 的地址按裸路径上报；24 小时去重挡在本地。 */
    }
    <script is:inline>
      (() => {
        const path = location.pathname;
        const key = `views:${path}`;
        const day = 24 * 60 * 60 * 1000;
        const show = count => {
          const element = document.querySelector("#views");
          if (!element || !count) return;
          element.textContent = `${count} 次阅读`;
          element.hidden = false;
        };

        let cached = null;
        try {
          cached = JSON.parse(localStorage.getItem(key) ?? "null");
        } catch {}

        const report = () =>
          fetch("/api/views", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ path }),
          })
            .then(response => (response.ok ? response.json() : null))
            .then(data => {
              if (!data || !data.count) return;
              try {
                localStorage.setItem(
                  key,
                  JSON.stringify({ at: Date.now(), count: data.count })
                );
              } catch {}
              show(data.count);
            })
            .catch(() => {});

        if (cached && Date.now() - cached.at < day) show(cached.count);
        else if ("requestIdleCallback" in window)
          requestIdleCallback(report, { timeout: 2000 });
        else setTimeout(report, 200);
      })();
    </script>

    <script is:inline>
      document.querySelector("#theme-btn")?.addEventListener("click", () => {
        const next =
          document.firstElementChild?.getAttribute("data-theme") === "dark"
            ? "light"
            : "dark";
        document.firstElementChild?.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>
