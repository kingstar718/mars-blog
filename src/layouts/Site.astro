---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/site";

// 公开页面的外壳。搬自旧站的 Layout.astro，去掉了 i18n、sitemap 和
// 站点验证——这些等基础跑顺了再补。RSS 在 2026-08 补了回来（/feed.xml）。
// 字体和防闪烁脚本一字未改，
// 它们是阅读体验里最先被看见的部分。
//
// main 的类名对齐旧站的 Main.astro（app-layout pb-4），上边距由各页面
// 通过 mainClass 自己给——旧站就是这么分工的，首页 pt-8 pb-6，列表页 pt-8。

type Props = {
  title?: string;
  mainClass?: string;
  /**
   * 这一页算不算进浏览量。登录页和 404 不算——前者不是内容，
   * 后者的地址是任意的，计了只会往表里塞垃圾。
   */
  counted?: boolean;
};

const { title = site.title, mainClass = "pt-8", counted = true } = Astro.props;
const pageTitle = title === site.title ? title : `${title} · ${site.title}`;
---

<!doctype html>
<html lang={site.lang} class="overflow-y-scroll scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 不声明的话浏览器会自己去要 /favicon.ico，每个页面白挨一个 404 */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/fonts/noto-serif/font.css" />
    <link rel="stylesheet" href="/fonts/noto-serif-sc/font.css" />
    <link rel="stylesheet" href="/fonts/noto-sans-mono/font.css" />

    <title>{pageTitle}</title>
    {
      /* 全站一句，不分页面：文章页不需要自己的描述，
        真要分就得每篇手写一句，那是又一处「要人维护、写错了没人提示」的东西 */
    }
    <meta name="description" content={site.description} />
    <meta name="author" content={site.author} />

    <!--
      防闪烁：必须同步执行，在浏览器绘制之前把 data-theme 写到 <html> 上。
      不能加 defer/async，也不能挪到 body。
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        document.firstElementChild?.setAttribute(
          "data-theme",
          stored ?? (prefersDark ? "dark" : "light")
        );
      })();
    </script>
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground flex min-h-svh flex-col"
  >
    <Header />

    <main id="main-content" class:list={["app-layout pb-4", mainClass]}>
      <slot />
    </main>

    <Footer />

    <script is:inline>
      document.querySelector("#theme-btn")?.addEventListener("click", () => {
        const next =
          document.firstElementChild?.getAttribute("data-theme") === "dark"
            ? "light"
            : "dark";
        document.firstElementChild?.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
      });
    </script>

    {
      /* 浏览量在客户端累加：服务端渲染时加会把爬虫和预取一起算进去，
       而且页面一旦上了边缘缓存就再也不涨了。
       挂在外壳上而不是各页自己写——全站一个口径，加一个页面不用记得补。
       带 query 的地址一律按裸路径上报，否则 /search?q=… 会把表撑爆。
       返回的计数用来填 #views（只有文章页有这个元素）。

       本地先挡一道 24 小时去重：服务端本来也只算一次（api/views.ts 的限流），
       但那一次「不算」的判断要花两次 D1 写。HTML 有边缘缓存挡着，
       这条 POST 却每次访问都回源——它是全站最大的一笔数据库开销。
       挡下来时把上次拿到的数字显示出来：读者看到的是自己上次看到的数，
       最多旧 24 小时，比空着好。localStorage 用不了（隐私模式会抛）就照常上报。

       条件走 define:vars 而不是把 <script> 包进 {counted && …}：
       包进 JSX 表达式之后，脚本里 { method: "POST" } 的花括号会被当成
       JSX 表达式，Astro 能跑但 prettier 解析不了，format:check 会红。 */
    }
    <script is:inline define:vars={{ counted }}>
      if (counted) {
        const key = `views:${location.pathname}`;
        const day = 24 * 60 * 60 * 1000;

        const show = count => {
          const element = document.querySelector("#views");
          if (!element || !count) return;
          element.textContent = `${count} 次阅读`;
          element.hidden = false;
        };

        let cached = null;
        try {
          cached = JSON.parse(localStorage.getItem(key) ?? "null");
        } catch {}

        if (cached && Date.now() - cached.at < day) {
          show(cached.count);
        } else {
          // 上报不参与首屏，等浏览器空下来再发
          const report = () =>
            fetch("/api/views", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ path: location.pathname }),
            })
              .then(response => (response.ok ? response.json() : null))
              .then(data => {
                if (!data || !data.count) return;
                try {
                  localStorage.setItem(
                    key,
                    JSON.stringify({ at: Date.now(), count: data.count })
                  );
                } catch {}
                show(data.count);
              })
              .catch(() => {});

          if ("requestIdleCallback" in window) {
            requestIdleCallback(report, { timeout: 2000 });
          } else {
            setTimeout(report, 200);
          }
        }
      }
    </script>
  </body>
</html>
