---
// 短文里的图做成画廊。放在渲染短文的页面上（首页、短文列表页）。
//
// markdown 只能直出一串 <img>，画廊需要一个额外的大图元素，光靠 CSS 搭不出来，
// 所以在运行时把结构补上：大图插到缩略图条前面（CSS 里 order-first + w-full），
// 缩略图退化成选择器，点哪张大图就换哪张。默认选中第一张。
//
// 不做弹层：短文本身内联在时间线里，覆盖全屏的层打断感太强。
//
// 渐进增强：脚本没跑，缩略图照常显示，只是没有大图、点了没反应。
---

<script is:inline data-astro-rerun>
  (() => {
    const buildGallery = paragraph => {
      // 已经建过就跳过：客户端路由回退到缓存页面时这里会重复触发
      if (paragraph.querySelector(".note-preview")) return;

      const thumbnails = [...paragraph.querySelectorAll(":scope > img")];
      if (thumbnails.length === 0) return;

      const preview = document.createElement("span");
      preview.className = "note-preview";
      const previewImage = document.createElement("img");
      preview.appendChild(previewImage);
      paragraph.prepend(preview);

      // 单图时缩略图条是多余的，藏掉，只留大图
      if (thumbnails.length === 1) paragraph.classList.add("is-single");

      const select = thumbnail => {
        for (const name of [
          "src",
          "srcset",
          "sizes",
          "width",
          "height",
          "alt",
        ]) {
          const value = thumbnail.getAttribute(name);
          if (value === null) previewImage.removeAttribute(name);
          else previewImage.setAttribute(name, value);
        }
        for (const item of thumbnails) {
          item.classList.toggle("is-active", item === thumbnail);
        }
      };

      for (const thumbnail of thumbnails) {
        thumbnail.addEventListener("click", () => select(thumbnail));
      }

      select(thumbnails[0]);
    };

    const buildAll = () =>
      document.querySelectorAll(".note-thumbs p").forEach(buildGallery);

    buildAll();

    // 监听只挂一次；buildAll 本身幂等，切页后重跑即可
    const stateKey = "__astroPaperNoteGallery";
    if (!window[stateKey]) {
      window[stateKey] = true;
      document.addEventListener("astro:after-swap", buildAll);
    }
  })();
</script>
