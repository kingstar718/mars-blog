---
// 随记里的图：默认只出缩略图条，点一下就地展开大图，再点收起。
//
// markdown 只能直出一串 <img>，大图需要一个额外的元素，光靠 CSS 搭不出来，
// 所以在运行时把结构补上：大图插到缩略图条前面（CSS 里 order-first + w-full），
// 缩略图既是选择器也是开关。
//
// 不默认展开：一列随记里，每条都先摊开一张三百多像素高的图，翻起来太重。
// 展开与否交给读者——想看点一下，看完再点一下收掉。
//
// 不做弹层：随记本身内联在时间线里，覆盖全屏的层打断感太强。
//
// 渐进增强：脚本没跑，缩略图照常显示，只是点了没反应。
---

<script is:inline data-astro-rerun>
  (() => {
    const buildGallery = paragraph => {
      const thumbnails = [...paragraph.querySelectorAll(":scope > img")];
      if (thumbnails.length === 0) return;
      // 已经装过就跳过：客户端路由回退到缓存页面时这里会重复触发
      if (paragraph.dataset.gallery) return;
      paragraph.dataset.gallery = "1";
      // 缩略图条只有 80px 高，最小档就够；把 src 换成 data-thumb
      //（rehype 写入的 400 jpg），并卸掉 srcset/sizes，
      // 不然浏览器按正文宽度挑 800/1600 档，缩略图白白下载大图。
      for (const item of thumbnails) {
        if (item.dataset.thumb) {
          item.src = item.dataset.thumb;
          item.removeAttribute("srcset");
          item.removeAttribute("sizes");
        } else {
          // 老图（改动前上传，没有 data-thumb）：短引用解析失败时
          // 退回 400.jpg，别让整张缩略图裂掉
          item.addEventListener("error", () => {
            if (item.dataset.fallback) return;
            const uid = item.src.match(/\/media\/([0-9a-f-]+)/)?.[1];
            if (!uid) return;
            item.dataset.fallback = "1";
            // 先卸掉 srcset/sizes，否则浏览器仍按原候选选档，降级不生效
            item.removeAttribute("srcset");
            item.removeAttribute("sizes");
            item.src = `/media/${uid}/400.jpg`;
          });
        }
      }
      // 只有一张图时不存在切换，大图按原比例展示（多图要统一成 3:2，
      // 否则换一张页面就上下弹一次）
      if (thumbnails.length === 1) paragraph.classList.add("is-single");

      let preview = null;

      const collapse = () => {
        preview?.remove();
        preview = null;
        for (const item of thumbnails) item.classList.remove("is-active");
      };

      const expand = thumbnail => {
        if (!preview) {
          preview = document.createElement("span");
          preview.className = "note-preview";
          const image = document.createElement("img");
          // 大图失败逐档降级 1600→800→400，全失败就把预览藏掉，
          // 不让读者看到裂图
          image.addEventListener("error", () => {
            const uid = image.src.match(/\/media\/([0-9a-f-]+)/)?.[1];
            const sized = image.src.match(
              /\/media\/([0-9a-f-]+)\/(\d+)\.(jpg|jpeg|webp)$/
            );
            let next = null;
            if (sized) {
              const width = Number(sized[2]);
              next = width > 800 ? 800 : width > 400 ? 400 : null;
            }
            if (next !== null) {
              // 降级前先卸掉 srcset/sizes，src 才会真正生效
              image.removeAttribute("srcset");
              image.removeAttribute("sizes");
              image.src = `/media/${uid}/${next}.${sized[3]}`;
            } else if (uid && !image.dataset.fallback) {
              // 短引用（无档位）失败：直接试 800.jpg
              image.dataset.fallback = "1";
              image.removeAttribute("srcset");
              image.removeAttribute("sizes");
              image.src = `/media/${uid}/800.jpg`;
            } else {
              image.hidden = true;
            }
          });
          // 大图本身也能收起来：展开之后缩略图条被推到大图下面，
          // 视线可能已经离开，让手边最大的那个目标也可点
          image.addEventListener("click", collapse);
          preview.appendChild(image);
          paragraph.prepend(preview);
        }

        const image = preview.querySelector("img");
        // 大图用 800 档：data-full 是 rehype 重写时写入的 ≤800 最大 jpg
        //（1600 只归档不下发），没有就退回缩略图自己的 src。尺寸
        //（width/height）也换成大图的，避免浏览器按缩略图的 400px 宽高
        // 预布局，换图时页面不弹。
        const full = thumbnail.dataset.full ?? thumbnail.getAttribute("src");
        image.src = full;
        if (thumbnail.dataset.srcset) image.srcset = thumbnail.dataset.srcset;
        else image.removeAttribute("srcset");
        if (thumbnail.dataset.sizes) image.sizes = thumbnail.dataset.sizes;
        else image.removeAttribute("sizes");
        const width = thumbnail.dataset.fullWidth;
        const height = thumbnail.dataset.fullHeight;
        if (width) image.width = Number(width);
        if (height) image.height = Number(height);
        const alt = thumbnail.getAttribute("alt");
        if (alt === null) image.removeAttribute("alt");
        else image.setAttribute("alt", alt);
        for (const item of thumbnails) {
          item.classList.toggle("is-active", item === thumbnail);
        }
      };

      for (const thumbnail of thumbnails) {
        thumbnail.addEventListener("click", () => {
          // 再点当前这张就收起来——放大和缩小是同一个动作的两半
          if (thumbnail.classList.contains("is-active")) collapse();
          else expand(thumbnail);
        });
      }
    };

    const buildAll = () =>
      document.querySelectorAll(".note-thumbs p").forEach(buildGallery);

    buildAll();

    // 监听只挂一次；buildAll 本身幂等，切页后重跑即可
    const stateKey = "__astroPaperNoteGallery";
    if (!window[stateKey]) {
      window[stateKey] = true;
      document.addEventListener("astro:after-swap", buildAll);
    }
  })();
</script>
