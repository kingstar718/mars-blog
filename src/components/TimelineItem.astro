---
import Datetime from "./Datetime.astro";

// 时间线上的一条：圆点 + 时间，正文由 slot 提供。
//
// 圆点只有空心一种。早先分实心/空心是为了在混排的首页区分文章和随记，
// 那个首页已经换成关于页，文章索引也不走时间线了——现在这条线上只有随记，
// 再分两种形状就是在区分一个不存在的东西。
type Props = {
  pubDatetime: string;
};

const { pubDatetime } = Astro.props;
---

<article class="group relative pb-6 last:pb-0">
  {
    /* 圆点 7px，圆心落在竖线起点（容器顶部下方 10px）上，左右与竖线同轴：
       左移 = 容器内边距(26) − 竖线半宽(1) + 圆点半径(3.5) = 28.5px
       上移 = 10 − 圆点半径(3.5) = 6.5px
       再收一档不透明度，免得圆点比标题还抢眼。 */
  }
  <span
    aria-hidden="true"
    class="border-accent bg-background absolute start-[calc(-1.5rem-4.5px)] top-[6.5px] size-[7px] rounded-full border-2 opacity-80"
  ></span>
  <Datetime pubDatetime={pubDatetime} class="tabular-nums" />
  <slot name="actions" />
  <slot />
</article>
