---
import NoteInline from "@/components/admin/NoteInline";

// 登录后才出现的那一层：新增入口 + 短文的就地编辑器。
//
// 按钮本身是几行原生 JS，只把点击转成事件交给 React 岛。
// 事件委托挂在 document 上，分页换页后也不用重新绑定。

type Props = {
  /** 新增按钮指向哪一类；短文用就地编辑器，文章跳后台 */
  create?: "post" | "note";
};

const { create } = Astro.props;
---

{
  create === "post" && (
    <button
      type="button"
      id="new-post"
      class="text-muted-foreground hover:text-accent mb-4 inline-block text-sm"
    >
      + 新文章
    </button>
  )
}

{
  create === "note" && (
    <Fragment>
      <button
        type="button"
        id="new-note"
        class="text-muted-foreground hover:text-accent cursor-pointer text-sm"
      >
        + 新短文
      </button>
      {/* 新短文的编辑器落在这里，紧挨着按钮下方 */}
      <div data-note-editor-slot="new" class="mb-4" />
    </Fragment>
  )
}

<NoteInline client:idle />

<script>
  // 短文的编辑 / 新增：把事件转给那个 React 岛。
  // 删除不在列表里，它跟着编辑态的按钮行走（见 admin/NoteInline.tsx、
  // admin/PostInline.tsx）。
  document.addEventListener("click", event => {
    const edit = (event.target as HTMLElement).closest<HTMLElement>(
      "[data-edit-note]"
    );
    if (edit) {
      dispatchEvent(
        new CustomEvent("note:edit", { detail: Number(edit.dataset.editNote) })
      );
      return;
    }
    if ((event.target as HTMLElement).closest("#new-note")) {
      dispatchEvent(new CustomEvent("note:new"));
    }
  });

  // 新文章：先建一条空草稿，再去它自己的页面上写。
  // 文章不像短文能在列表里就地展开——它有标题、有目录、有评论，
  // 那些都长在文章页上，所以「新建」就是「去那一页」。
  document.querySelector("#new-post")?.addEventListener("click", async () => {
    const response = await fetch("/api/admin/entries", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ kind: "post", title: "", body: "" }),
    });
    if (!response.ok) {
      alert("新建失败");
      return;
    }
    const { id } = (await response.json()) as { id: number };
    location.assign(`/posts/${id}?edit=1`);
  });
</script>
