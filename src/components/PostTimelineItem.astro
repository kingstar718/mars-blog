---
import TimelineItem from "./TimelineItem.astro";
import EntryActions from "./EntryActions.astro";
import type { EntryRow } from "@/lib/db";

// 时间线上的一篇文章：首页和文章列表页共用，保证两处渲染完全一致。
type Props = {
  post: EntryRow;
};

const { post } = Astro.props;
const session = Astro.locals.session;
---

<TimelineItem kind="post" pubDatetime={post.pub_datetime}>
  {session && <EntryActions slot="actions" id={post.id} />}
  <h2 class="mt-1 inline-block text-lg font-medium">
    <a
      href={`/posts/${post.id}`}
      class="hover:text-accent decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0"
    >
      {post.title}
    </a>
  </h2>
</TimelineItem>
