---
import EntryActions from "./EntryActions.astro";
import { formatMachine } from "@/lib/datetime";
import type { EntryRow } from "@/lib/db";

// 文章索引里的一行：左边月日，右边标题。
//
// 索引不用时间线：那一页每个圆点都是实心的，「实心=文章、空心=短文」
// 在只有文章的页面上不传递任何信息，纯装饰，还要为它让出左缩进和行距。
// 索引要的是密度和可检索——一屏看二三十篇，而不是十来篇。
// 年份由外层按分组打小标题，所以这里只留月日。

type Props = {
  post: EntryRow;
};

const { post } = Astro.props;
const session = Astro.locals.session;
---

<div class="group relative flex items-baseline gap-4 py-1.5">
  <time
    class="text-faint w-12 shrink-0 text-sm tabular-nums"
    datetime={formatMachine(post.pub_datetime)}
  >
    {post.pub_datetime.slice(5, 10)}
  </time>

  <a
    href={`/posts/${post.id}`}
    class="hover:text-accent decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline"
  >
    {post.title || "（无标题）"}
  </a>

  {
    /* 草稿只有登录时才会被查出来，不用再判断一次会话 */
    post.status === "draft" && <span class="text-faint text-xs">草稿</span>
  }

  {session && <EntryActions id={post.id} align="center" />}
</div>
