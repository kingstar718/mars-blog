---
// 分页。只出「‹ 2 / 5 ›」这么多——旧站已经去掉了「上一页 / 下一页」的文字：
// 它和统计并排在 ListFooter 里，字号和颜色由外层统一，这里不自带。

type Props = {
  current: number;
  total: number;
  /** 版块根地址，如 /posts；第一页就是它本身 */
  base: string;
};

const { current, total, base } = Astro.props;

// 第二页起是 /posts/page/2 而不是 /posts/2：后者会被 posts/[id].astro 抢走
// ——单段动态路由的优先级高于 [...page]，于是「第 2 页」会渲染成「id=2 的文章」。
// 多垫一个 page 段，两条路由的形状就不再重叠。
const href = (page: number) => (page <= 1 ? base : `${base}/page/${page}`);
---

{
  total > 1 && (
    <span class="inline-flex items-center gap-2 tabular-nums">
      {current > 1 ? (
        <a
          href={href(current - 1)}
          aria-label="上一页"
          class="hover:text-accent"
        >
          ‹
        </a>
      ) : (
        <span aria-hidden="true" class="opacity-30">
          ‹
        </span>
      )}
      <span>
        {current} / {total}
      </span>
      {current < total ? (
        <a
          href={href(current + 1)}
          aria-label="下一页"
          class="hover:text-accent"
        >
          ›
        </a>
      ) : (
        <span aria-hidden="true" class="opacity-30">
          ›
        </span>
      )}
    </span>
  )
}
