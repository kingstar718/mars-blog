---
import { site } from "@/site";

// 页脚只有一行：居中的版权，右端是退出（登录时才有）。
//
// 版权写成「© 2026 陆上江南」——这是现在通行的写法。
// 原来那句 "Copyright © 2026 | All rights reserved." 把同一件事说了三遍：
// Copyright 和 © 是同义的，二选一；"All rights reserved" 来自已经作废的
// 布宜诺斯艾利斯公约，《伯尔尼公约》之下作品自完成起就自动受保护，
// 这句话不写也不会少一分权利。中文站点要更正式的话写「版权所有 © 2026 陆上江南」，
// 个人博客用最短的那版就够。

// 没有 Props：唯一的调用点是 Site.astro 的 <Footer />，一个参数都没传过。
// mt-auto 把页脚推到视口底部，配合 body 的 flex min-h-svh，短页面也不会悬空。

const currentYear = new Date().getFullYear();
// 站点没有后台，退出的入口就落在这里；未登录时页脚一个字都不多
const session = Astro.locals.session;
// 站名就是联系方式：点一下写邮件。关于页里不再单独留一行联系信息——
// 一个个人博客的联系方式属于页脚，不属于自我介绍。
const copyright = `© ${currentYear} `;
---

<footer class="app-layout text-muted-foreground mt-auto text-sm">
  {/* 版权居中，退出绝对定位到右端：两者在同一行，且版权不会被挤偏 */}
  <div class="relative flex items-center justify-center pt-12 pb-8">
    <span class="whitespace-nowrap">
      {copyright}
      <a href={`mailto:${site.email}`} class="hover:text-accent">
        {site.title}
      </a>
    </span>
    {
      /* 退出是 POST：GET 的退出链接会被预取、被爬虫点掉 */
      session && (
        <form method="POST" action="/api/auth/logout" class="absolute end-0">
          <button type="submit" class="text-faint hover:text-accent text-xs">
            退出
          </button>
        </form>
      )
    }
  </div>
</footer>
