---
import type { HTMLAttributes } from "astro/types";

// 与 astro-paper-blog 的 Footer.astro 一致：居中、上下留白 pt-12 pb-8，
// 中间那道竖线只在 sm 以上出现，窄屏改成两行。

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const currentYear = new Date().getFullYear();
// 站点没有后台，退出的入口就落在这里；未登录时页脚一个字都不多
const session = Astro.locals.session;
---

<footer
  class:list={[
    "app-layout text-muted-foreground text-sm",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div class="flex flex-col items-center pt-12 pb-8">
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>Copyright &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>All rights reserved.</span>
    </div>
    {
      /* 退出是 POST：GET 的退出链接会被预取、被爬虫点掉 */
      session && (
        <form method="POST" action="/api/auth/logout" class="mt-1">
          <button type="submit" class="text-faint hover:text-accent text-xs">
            退出（{session.login}）
          </button>
        </form>
      )
    }
  </div>
</footer>
