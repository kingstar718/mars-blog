---
import { site } from "@/site";

// 页脚只有一行：居中的版权。登录时左端显示全站访问量，右端是退出。
//
// 版权写成「© 2026 陆上江南」——这是现在通行的写法。
// 原来那句 "Copyright © 2026 | All rights reserved." 把同一件事说了三遍：
// Copyright 和 © 是同义的，二选一；"All rights reserved" 来自已经作废的
// 布宜诺斯艾利斯公约，《伯尔尼公约》之下作品自完成起就自动受保护，
// 这句话不写也不会少一分权利。中文站点要更正式的话写「版权所有 © 2026 陆上江南」，
// 个人博客用最短的那版就够。

// 没有 Props：唯一的调用点是 Site.astro 的 <Footer />，一个参数都没传过。
// mt-auto 把页脚推到视口底部，配合 body 的 flex min-h-svh，短页面也不会悬空。

const currentYear = new Date().getFullYear();
const copyright = `© ${currentYear} `;
---

<footer class="app-layout text-muted-foreground mt-auto text-sm">
  {/* 版权居中，退出绝对定位到右端：两者在同一行，且版权不会被挤偏 */}
  <div class="relative flex items-center justify-center pt-12 pb-8">
    {/* 全站合计镜像摆在左端，和右端的退出对称，版权仍然居中 */}
    <span
      id="total-views"
      class="text-faint absolute start-0 hidden text-xs tabular-nums"></span>
    <span class="whitespace-nowrap">
      {copyright}
      <a href={`mailto:${site.email}`} class="hover:text-accent">
        {site.title}
      </a>
      {/* 订阅源：站上唯一的读者出口，放在站名旁边不抢版面 */}
      <a href="/feed.xml" class="text-faint hover:text-accent ms-3 text-xs">
        RSS
      </a>
    </span>
    {/* 退出是 POST：GET 的退出链接会被预取、被爬虫点掉 */}
    <div
      class="absolute end-0 flex hidden items-center gap-3"
      id="footer-actions"
    >
      <button
        type="button"
        id="logout"
        class="text-faint hover:text-accent text-xs"
      >
        退出
      </button>
    </div>
  </div>
</footer>

<script>
  import { checkSession } from "@/components/admin/session";

  const views = document.querySelector<HTMLElement>("#total-views");
  const actions = document.querySelector<HTMLElement>("#footer-actions");
  const logout = document.querySelector<HTMLButtonElement>("#logout");

  void checkSession().then(async ok => {
    if (!ok || !views || !actions || !logout) return;
    try {
      const response = await fetch("/api/views/total");
      if (response.ok) {
        const { total } = (await response.json()) as { total: number };
        views.textContent = `${total} 次访问`;
        views.classList.remove("hidden");
      }
    } catch {}
    actions.classList.remove("hidden");
    logout.addEventListener("click", async () => {
      await fetch("/api/auth/logout", { method: "POST" });
      location.reload();
    });
  });
</script>
