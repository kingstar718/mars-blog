---
// 标题旁的 AI 标记：时间线和文章页共用，两处样式保持一致。
// 刻意放在 <h1>/<h2> 外面——它不是标题的一部分，
// 混进标题文本会一并进入 <title>、RSS、搜索索引和无障碍朗读。
const label = "正文由 AI 辅助生成";
---

<span
  class="text-accent ms-1.5 align-[0.3em] text-[0.55em] font-normal tracking-[0.1em] select-none"
  title={label}
  aria-label={label}
  data-pagefind-ignore>AI</span
>
