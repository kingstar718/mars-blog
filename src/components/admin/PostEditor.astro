---
// 挂载脚本，本体在 postEditor.ts。单独成组件的理由见 NoteEditor.astro。
//
// id 和 status 从占位 div 的 data 属性上读：Astro 的 <script> 是独立打包的
// 模块，拿不到组件作用域里的变量，而 define:vars 会把它降级成内联脚本、
// 不能再 import。数据挂在本来就要有的那个占位上，不额外加元素。
---

<script>
  import { mountPostEditor } from "./postEditor";

  const slot = document.querySelector<HTMLElement>("[data-post-editor-slot]");
  if (slot) {
    mountPostEditor(
      Number(slot.dataset.postId),
      slot.dataset.postStatus ?? "draft"
    );
  }
</script>
