---
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import { site } from "@/site";

// 站点头：左边是标题和栏目，右边是搜索和主题两个图标。
//
// 按类分组，不按左右分：标题和栏目是同一样东西（站点结构），
// 工具是另一样。都堆在右上角的话，四个元素连成一排，中间四百多像素空着，
// 重心整个偏右。移动端和桌面是同一套结构，只差字号间距。
//
// 没有汉堡菜单。astro-paper 那套是为五六个栏目准备的，
// 这里只剩两个栏目、四个汉字，而移动端标题和右侧之间本来就空着两百多像素——
// 为两个链接做一个下拉浮层，代价是多一次点击、三十行脚本和两个图标文件。
//
// 也没有分隔竖线：两个链接和两个图标之间，间距足够区分。

const currentPath =
  Astro.url.pathname !== "/" && Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname.slice(0, -1)
    : Astro.url.pathname;

// 同一栏目下的详情页也算选中：/posts/12 要让「文章」高亮
const isActive = (path: string) => {
  const current = currentPath.split("/").filter(Boolean);
  const target = path.split("/").filter(Boolean);
  return currentPath === path || current[0] === target[0];
};

// 没有「关于」：首页就是关于页，左上角的站点标题就是它的入口
const navLinks = [
  { path: "/posts", label: "文章" },
  { path: "/notes", label: "随记" },
];

// 移动端 py-2 是为了凑够 40px 的点击区域，桌面上不需要那么松
const navLinkClass = "hover:text-accent block px-2 py-2 sm:py-1";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  跳转到正文
</a>

<header class="app-layout">
  <div class="bg-background flex items-center justify-between py-4 sm:py-6">
    {
      /* 标题和栏目同组。基线对齐而不是居中：两者字号不同，
        居中会让栏目看着往上飘 */
    }
    <div class="flex items-baseline gap-1 sm:gap-3">
      <a
        href="/"
        class="text-xl leading-none font-medium whitespace-nowrap sm:text-2xl"
      >
        {site.title}
      </a>

      <nav>
        <ul class="flex items-baseline font-medium">
          {
            navLinks.map(link => (
              <li>
                <a
                  href={link.path}
                  class:list={[
                    navLinkClass,
                    { "active-nav": isActive(link.path) },
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="flex items-center gap-1">
      <a
        href="/search"
        class="hover:text-accent relative inline-flex size-9 items-center sm:size-8"
        title="搜索"
        aria-label="搜索"
      >
        <IconSearch
          class:list={[
            "absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2",
            { "stroke-accent": isActive("/search") },
          ]}
        />
        <span class="sr-only">搜索</span>
      </a>

      <button
        id="theme-btn"
        class="hover:[&>svg]:stroke-accent relative size-9 sm:size-8"
        title="切换主题"
        aria-label="auto"
        aria-live="polite"
      >
        <IconMoon
          class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
        />
        <IconSunHigh
          class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
        />
      </button>
    </div>
  </div>
</header>
