---
import Datetime from "./Datetime.astro";
import EntryActions from "./EntryActions.astro";

// 时间线上的一条随记。随记没有标题也没有详情页，
// 正文是发布时渲染好的 HTML，直接内联展开。
//
// 圆点和缩进不在这里——整条线的几何都归 Timeline.astro，这里只声明
// 自己是 .timeline-item。原来中间还隔着一个 TimelineItem 组件，
// 它剩下的东西（article 外壳、日期、一个 actions 具名 slot）只有这一个
// 消费者，合过来之后那个具名 slot 的中转也省了。
//
// 配图默认只出缩略图条，点一下才就地展开大图（见 NoteImageZoom）：
// 一列随记里，每条都先摊开一张三百多像素高的图，翻起来太重。
type Props = {
  /** 站点时间 'YYYY-MM-DD HH:mm:ss' */
  pubDatetime: string;
  /** 已渲染的正文 HTML */
  html: string;
  id: number;
  /** 草稿只有登录时才查得出来，标记跟着日期走，和文章索引一致 */
  draft?: boolean;
};

const { pubDatetime, html, id, draft = false } = Astro.props;
const session = Astro.locals.session;
---

<article class="timeline-item group pb-6 last:pb-0">
  <Datetime pubDatetime={pubDatetime} class="tabular-nums" />
  {draft && <span class="text-faint ms-2 text-xs">草稿</span>}
  {session && <EntryActions id={id} />}
  {
    /*
    正文走 app-prose 的阅读态字号：这一页上只有随记，每条都是完整内容，
    读者就是在这儿读完的——它是正文，不是索引。
    （早先压到 16px 是为了在首页跟文章标题对齐，那个混排首页已经没了。）
    段落间距收紧，并去掉首尾外边距，避免和条目间距叠加。
  */
  }
  <div
    data-note-body={id}
    class:list={[
      "app-prose note-thumbs mt-2 max-w-none [&_p]:my-[0.5em] [&_p:has(img)]:my-3 [&>:first-child]:mt-0 [&>:last-child]:mb-0",
      // 进出编辑态时正文要淡出淡入，过渡写在这里而不是临时加，
      // 否则加类的同一帧还没有 transition，会直接闪掉
      session && "transition-opacity duration-150",
    ]}
    set:html={html}
  />
  {/* 编辑器就地挂进这里，见 admin/noteEditor.ts */}
  {session && <div data-note-editor-slot={id} />}
</article>
