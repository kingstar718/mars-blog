---
import TimelineItem from "./TimelineItem.astro";
import EntryActions from "./EntryActions.astro";

// 时间线上的一条短文：首页和短文列表页共用，保证两处渲染完全一致。
// 短文没有标题也没有详情页，正文是发布时渲染好的 HTML，直接内联展开。
type Props = {
  /** 站点时间 'YYYY-MM-DD HH:mm:ss' */
  pubDatetime: string;
  /** 已渲染的正文 HTML */
  html: string;
  id: number;
};

const { pubDatetime, html, id } = Astro.props;
const session = Astro.locals.session;
---

<TimelineItem kind="note" pubDatetime={pubDatetime}>
  {session && <EntryActions slot="actions" id={id} inline />}
  {
    /*
    正文样式取 app-prose，字号行高由 reading-note 压回列表态（16px/1.625，
    理由见 theme.css）。同一个类也加在编辑器外层，两态共用一份 token。
    段落间距同时收紧，并去掉首尾外边距，避免和条目间距叠加。
  */
  }
  <div
    data-note-body={id}
    class:list={[
      "app-prose reading-note note-thumbs mt-2 max-w-none [&_p]:my-[0.5em] [&_p:has(img)]:my-3 [&>:first-child]:mt-0 [&>:last-child]:mb-0",
      // 进出编辑态时正文要淡出淡入，过渡写在这里而不是临时加，
      // 否则加类的同一帧还没有 transition，会直接闪掉
      session && "transition-opacity duration-150",
    ]}
    set:html={html}
  />
  {/* 编辑器就地渲染进这里，见 admin/NoteInline.tsx */}
  {session && <div data-note-editor-slot={id} />}
</TimelineItem>
