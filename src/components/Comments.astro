---
// 评论（v3 静态版）：读者端只负责渲染和提交，数据在 Pages Functions
//（/api/comments，D1 存储 + 审核 + 限流）。新评论一律 pending，作者审核后出现。

type Props = {
  slug: string;
};

const { slug } = Astro.props;
---

<section id="comments" data-slug={slug} class="mt-16">
  {/* 列表由脚本渲染：读者只看已通过；登录时 ?all=1 含待审，就地审核 */}
  <ul id="comments-list" class="mb-10 space-y-6"></ul>

  {/* 与 v2 一致：表单吃满正文栏宽度，不单独收窄 */}
  <form id="comment-form">
    <div
      class="border-border focus-within:border-accent/60 -mx-2 rounded-md border px-2 py-1 transition-colors"
    >
      <textarea
        name="body"
        required
        rows="2"
        maxlength="2000"
        placeholder="说点什么"
        class="reading-note w-full resize-y bg-transparent py-1 outline-none"
      ></textarea>
    </div>

    {/* 蜜罐：真人看不见，脚本会填 */}
    <input
      name="website"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="absolute h-0 w-0 opacity-0"
    />

    {/* 称呼和提交挤在同一行：一条评论不值得占三行 */}
    <div
      class="text-muted-foreground mt-3 flex flex-wrap items-center gap-4 text-sm"
    >
      <input
        name="author"
        required
        maxlength="24"
        placeholder="称呼"
        class="focus:border-accent/60 w-24 border-b border-transparent bg-transparent outline-none"
      />
      <button type="submit" class="text-accent font-medium">提交</button>
      <span id="comment-hint" class="text-faint text-xs"></span>
    </div>
  </form>
</section>

<script>
  import { checkSession } from "@/components/admin/session";

  const section = document.querySelector<HTMLElement>("#comments");
  const slug = section?.dataset.slug ?? "";
  const list = document.querySelector<HTMLUListElement>("#comments-list");
  const form = document.querySelector<HTMLFormElement>("#comment-form");
  const hint = document.querySelector<HTMLSpanElement>("#comment-hint");
  if (!list || !form || !hint) throw new Error("评论组件结构缺失");

  const escape = (text: string) =>
    text.replace(
      /[&<>]/g,
      c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]!
    );

  const load = async () => {
    // 登录时带上 ?all=1：返回含待审的完整列表，供站长就地审核
    const admin = await checkSession();
    const response = await fetch(
      `/api/comments?slug=${encodeURIComponent(slug)}${admin ? "&all=1" : ""}`
    );
    const data = (await response.json().catch(() => null)) as {
      comments?: {
        id: number;
        author: string;
        body: string;
        created_at: string;
        status: "pending" | "approved" | "spam";
      }[];
    } | null;
    list.innerHTML = (data?.comments ?? [])
      .map(comment => {
        const pending = comment.status === "pending" ? "<span>待审</span>" : "";
        const buttons =
          admin && comment.status !== "spam"
            ? `<span class="ms-auto flex gap-3 text-xs opacity-0 transition-opacity group-hover/comment:opacity-100 focus-within:opacity-100 max-md:opacity-70">
                ${
                  comment.status === "pending"
                    ? `<button type="button" class="hover:text-accent" data-comment="${comment.id}" data-status="approved">通过</button>`
                    : ""
                }
                <button
                  type="button"
                  class="hover:text-red-600"
                  data-comment="${comment.id}"
                  data-status="spam"
                >
                  垃圾
                </button>
              </span>`
            : "";
        return `
          <li class="group/comment ${comment.status === "pending" ? "opacity-70" : ""}">
            <div class="text-faint flex items-baseline gap-3 text-sm">
              <span class="text-muted-foreground">${escape(comment.author)}</span>
              <time class="tabular-nums">${escape(comment.created_at)}</time>
              ${pending}${buttons}
            </div>
            <p class="reading-note mt-1 whitespace-pre-wrap">${escape(
              comment.body
            )}</p>
          </li>`;
      })
      .join("");
  };

  // 审核：点一下就落库，成功后刷新
  document.addEventListener("click", async event => {
    const button = (event.target as HTMLElement).closest<HTMLElement>(
      "[data-comment]"
    );
    if (!button) return;
    const status = button.dataset.status;
    if (status === "spam" && !confirm("标为垃圾后这条评论不再显示，确定吗？")) {
      return;
    }
    const response = await fetch("/api/admin/comments", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ id: Number(button.dataset.comment), status }),
    });
    if (response.ok) location.reload();
    else alert("操作失败");
  });

  form.addEventListener("submit", async event => {
    event.preventDefault();
    hint.textContent = "提交中…";
    const data = new FormData(form);
    data.set("slug", slug);
    const response = await fetch("/api/comments", {
      method: "POST",
      body: data,
    });
    const body = (await response.json().catch(() => null)) as {
      ok?: boolean;
      message?: string;
    } | null;
    if (response.ok && body?.ok) {
      form.reset();
      hint.textContent = "已提交，等作者审核后显示。";
    } else {
      hint.textContent = body?.message ?? "提交失败";
    }
  });

  load();
</script>
