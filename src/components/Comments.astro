---
import { db } from "@/lib/env";
import { listApproved, listForOwner } from "@/lib/comments";
import { formatDisplay } from "@/lib/datetime";

// 评论。列表服务端渲染，表单用原生 POST 兜底——
// 脚本没跑也能提交，只是会整页跳转。
//
// 排版跟着阅读态走，不另起一套：
// 不画横线（分隔靠留白），不加「评论」标题（有评论就摆在那儿，
// 没有就只剩一个输入框，都不需要一行字来说明），输入框和站里
// 其他编辑框是同一个方框，提交是一个文字按钮而不是一块色块——
// 页面上唯一的实心色块应该是配图，不是按钮。
//
// 审核也在这里：登录时待审评论就排在自己的位置上，下面跟着「通过 / 垃圾」。
// 攒在一个后台列表里的话，处理时看不见上下文——评论是回应某段话的，
// 得和那篇文章待在一起才判断得了。

type Props = {
  entryId: number;
};

const { entryId } = Astro.props;
const session = Astro.locals.session;
const { results } = session
  ? await listForOwner(db(), entryId)
  : await listApproved(db(), entryId);
---

<section class="mt-16">
  {
    results.length > 0 && (
      <ul class="mb-10 space-y-6">
        {results.map(comment => (
          <li
            class:list={[
              "group/comment",
              comment.status === "pending" && "opacity-70",
            ]}
          >
            <div class="text-faint flex items-baseline gap-3 text-sm">
              <span class="text-muted-foreground">{comment.author}</span>
              <time class="tabular-nums">
                {formatDisplay(comment.created_at)}
              </time>
              {comment.status === "pending" && <span>待审</span>}
              {/* 审核按钮只在悬停这条评论时出现：读自己的博客时不该满屏是按钮 */}
              {session && (
                <span class="ms-auto flex gap-3 text-xs opacity-0 transition-opacity group-hover/comment:opacity-100 focus-within:opacity-100 max-md:opacity-70">
                  {comment.status === "pending" && (
                    <button
                      type="button"
                      class="hover:text-accent"
                      data-comment={comment.id}
                      data-status="approved"
                    >
                      通过
                    </button>
                  )}
                  <button
                    type="button"
                    class="hover:text-red-600"
                    data-comment={comment.id}
                    data-status="spam"
                  >
                    垃圾
                  </button>
                </span>
              )}
            </div>
            {/* 正文用随记那一档字号：评论是一条条的，和列表里的随记同级 */}
            <p class="reading-note mt-1 whitespace-pre-wrap">{comment.body}</p>
          </li>
        ))}
      </ul>
    )
  }

  <form id="comment-form" method="POST" action={`/api/comments/${entryId}`}>
    <div
      class="border-border focus-within:border-accent/60 -mx-2 rounded-md border px-2 py-1 transition-colors"
    >
      <textarea
        name="body"
        required
        rows="2"
        maxlength="2000"
        placeholder="说点什么"
        class="reading-note w-full resize-y bg-transparent py-1 outline-none"
      ></textarea>
    </div>

    {/* 蜜罐：真人看不见，脚本会填 */}
    <input
      name="website"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="absolute h-0 w-0 opacity-0"
    />

    {/* 称呼和提交挤在同一行：一条评论不值得占三行 */}
    <div
      class="text-muted-foreground mt-3 flex flex-wrap items-center gap-4 text-sm"
    >
      <input
        name="author"
        required
        maxlength="24"
        placeholder="称呼"
        class="focus:border-accent/60 w-24 border-b border-transparent bg-transparent outline-none"
      />
      <button type="submit" class="text-accent font-medium">提交</button>
      <span id="comment-hint" class="text-faint text-xs"></span>
    </div>
  </form>
</section>

<script>
  // 审核：点一下就落库，成功后刷新，让服务端重新给一份列表
  document.addEventListener("click", async event => {
    const button = (event.target as HTMLElement).closest<HTMLElement>(
      "[data-comment]"
    );
    if (!button) return;
    const status = button.dataset.status;
    if (status === "spam" && !confirm("标为垃圾后这条评论不再显示，确定吗？")) {
      return;
    }
    const response = await fetch("/api/admin/comments", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ id: Number(button.dataset.comment), status }),
    });
    if (response.ok) location.reload();
    else alert("操作失败");
  });
</script>

<script is:inline>
  document
    .querySelector("#comment-form")
    ?.addEventListener("submit", async event => {
      event.preventDefault();
      const form = event.target;
      const hint = document.querySelector("#comment-hint");
      hint.textContent = "提交中…";
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
      });
      const result = await response.json();
      if (result.ok) {
        form.reset();
        hint.textContent = "已提交，等作者审核后显示。";
      } else {
        hint.textContent = result.message ?? "提交失败";
      }
    });
</script>
