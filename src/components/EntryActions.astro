---
import IconPencil from "@/assets/icons/IconPencil.svg";

// 登录后出现在条目右侧的入口：一个铅笔图标，仅此而已。
//
// 服务端渲染而不是客户端注入：中间件已经保证带会话的请求绕开边缘缓存，
// 这份 HTML 不会被发给匿名访客。客户端注入的话，首屏要等 JS，
// 按钮会闪一下才出现——「无感」的反面。
//
// 只出现在悬停时（触屏设备一律常显，那里没有 hover 可言）：
// 读自己的博客时不该满屏都是按钮。
//
// 「删除」不放在这里：列表是用来读的，一个误触就没了的按钮不该常驻在
// 每条内容旁边。删除统一放进编辑态的按钮行——想删就先进编辑态。

type Props = {
  id: number;
  /** 短文在列表里当场编辑；文章去它自己的页面上编辑（?edit=1 直接进编辑态） */
  inline?: boolean;
  /** 条目是一整块时对齐顶部，是单行时对齐行中 */
  align?: "top" | "center";
};

const { id, inline = false, align = "top" } = Astro.props;

const shell = [
  "text-faint hover:text-accent absolute end-0 opacity-0 transition-opacity group-hover:opacity-100 focus-visible:opacity-100 max-md:opacity-70",
  align === "center" ? "top-1/2 -translate-y-1/2" : "top-0",
].join(" ");
---

{
  inline ? (
    <button
      type="button"
      class={shell}
      title="编辑"
      aria-label="编辑"
      data-edit-note={id}
    >
      <IconPencil class="size-4" />
    </button>
  ) : (
    <a
      href={`/posts/${id}?edit=1`}
      class={shell}
      title="编辑"
      aria-label="编辑"
    >
      <IconPencil class="size-4" />
    </a>
  )
}
