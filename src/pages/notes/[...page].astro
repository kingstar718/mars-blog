---
import Site from "@/layouts/Site.astro";
import Timeline from "@/components/Timeline.astro";
import NoteTimelineItem from "@/components/NoteTimelineItem.astro";
import NoteImageZoom from "@/components/NoteImageZoom.astro";
import ListFooter from "@/components/ListFooter.astro";
import Pagination from "@/components/Pagination.astro";
import TimelineStats from "@/components/TimelineStats.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { toSiteString } from "@/lib/entries";
import { perPage } from "@/site";

export async function getStaticPaths() {
  const notes = (await getCollection("notes"))
    .filter(note => !note.data.draft)
    .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());
  const totalPages = Math.max(1, Math.ceil(notes.length / perPage.notes));
  const years = notes.reduce<[string, number][]>((acc, note) => {
    const year = String(note.data.pubDatetime.getFullYear());
    const last = acc.at(-1);
    if (last?.[0] === year) last[1] += 1;
    else acc.push([year, 1]);
    return acc;
  }, []);
  return Array.from({ length: totalPages }, (_, index) => {
    const page = index + 1;
    return {
      params: { page: page === 1 ? undefined : `page/${page}` },
      props: {
        current: page,
        totalPages,
        total: notes.length,
        years,
        notes: notes.slice((page - 1) * perPage.notes, page * perPage.notes),
      },
    };
  });
}

const { current, totalPages, total, years, notes } = Astro.props as {
  current: number;
  totalPages: number;
  total: number;
  years: [string, number][];
  notes: CollectionEntry<"notes">[];
};

const rendered = await Promise.all(
  notes.map(async note => ({
    note,
    Content: (await render(note)).Content,
  }))
);
---

<Site title="随记">
  <Timeline>
    {
      rendered.map(({ note, Content }) => (
        <NoteTimelineItem
          pubDatetime={toSiteString(note.data.pubDatetime)}
        >
          <Content />
        </NoteTimelineItem>
      ))
    }
  </Timeline>

  <ListFooter>
    <Pagination current={current} total={totalPages} base="/notes" />
    <TimelineStats total={total} unit="条" groups={years} />
  </ListFooter>

  <NoteImageZoom />
</Site>
