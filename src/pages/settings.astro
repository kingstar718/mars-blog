---
import Site from "@/layouts/Site.astro";
import { db } from "@/lib/env";
import { getS3Config } from "@/lib/media-settings";

// 站点设置（登录后才有入口，页脚那层）。
// 现在只有图片存储一件事：本地磁盘，或 S3 兼容存储。
// 保存时勾了「启用」会先做连接验证，验证不过不会保存。

const session = Astro.locals.session;
if (!session) return Astro.redirect("/login?next=/settings", 302);

const config = await getS3Config(db());
const hasSecret = Boolean(config?.secretAccessKey);
---

<Site title="设置" counted={false}>
  <div class="pt-8">
    <h1 class="text-xl font-semibold">存储设置</h1>
    <p class="text-muted-foreground mt-1 text-sm">
      图片默认存本地磁盘（.data/media）；填好 S3 兼容存储并启用后走对象存储。
    </p>

    <form id="s3-form" class="mt-6 max-w-md">
      <div
        class="border-border focus-within:border-accent/60 -mx-2 rounded-md border px-2 py-1 transition-colors"
      >
        <input
          type="text"
          name="endpoint"
          required
          placeholder="Endpoint（如 https://oss-cn-hangzhou.aliyuncs.com）"
          value={config?.endpoint ?? ""}
          class="reading-note w-full bg-transparent py-1 outline-none"
        />
      </div>

      <div
        class="border-border focus-within:border-accent/60 -mx-2 mt-2 rounded-md border px-2 py-1 transition-colors"
      >
        <input
          type="text"
          name="region"
          placeholder="Region（多数服务可留空）"
          value={config?.region ?? ""}
          class="reading-note w-full bg-transparent py-1 outline-none"
        />
      </div>

      <div
        class="border-border focus-within:border-accent/60 -mx-2 mt-2 rounded-md border px-2 py-1 transition-colors"
      >
        <input
          type="text"
          name="bucket"
          required
          placeholder="Bucket 名称"
          value={config?.bucket ?? ""}
          class="reading-note w-full bg-transparent py-1 outline-none"
        />
      </div>

      <div
        class="border-border focus-within:border-accent/60 -mx-2 mt-2 rounded-md border px-2 py-1 transition-colors"
      >
        <input
          type="text"
          name="accessKeyId"
          required
          placeholder="Access Key ID"
          value={config?.accessKeyId ?? ""}
          class="reading-note w-full bg-transparent py-1 outline-none"
        />
      </div>

      <div
        class="border-border focus-within:border-accent/60 -mx-2 mt-2 rounded-md border px-2 py-1 transition-colors"
      >
        <input
          type="password"
          name="secretAccessKey"
          autocomplete="new-password"
          placeholder={hasSecret
            ? "Secret Access Key（留空保持不变）"
            : "Secret Access Key"}
          class="reading-note w-full bg-transparent py-1 outline-none"
        />
      </div>

      <label class="text-muted-foreground mt-3 flex items-center gap-2 text-sm">
        <input
          type="checkbox"
          name="forcePathStyle"
          checked={config?.forcePathStyle !== false}
        />
        Path-style 地址（MinIO / 自建存储勾上；OSS 等云服务可留空）
      </label>

      <label class="text-muted-foreground mt-2 flex items-center gap-2 text-sm">
        <input
          type="checkbox"
          name="enabled"
          checked={config?.enabled === true}
        />
        启用 S3 存储（保存时会先验证连接）
      </label>

      <div class="text-muted-foreground mt-4 flex items-center gap-4 text-sm">
        <button type="submit" class="text-accent font-medium">保存</button>
        <button type="button" id="s3-test" class="text-accent font-medium"
          >测试连接</button
        >
        <span id="s3-msg" class="text-xs"></span>
      </div>
    </form>
  </div>
</Site>

<script>
  const form = document.querySelector<HTMLFormElement>("#s3-form");
  const message = document.querySelector<HTMLSpanElement>("#s3-msg");
  if (!form || !message) throw new Error("设置表单不存在");

  const show = (text: string, ok: boolean) => {
    message.textContent = text;
    message.className = `text-xs ${ok ? "text-green-600" : "text-red-600"}`;
  };

  const readForm = () => {
    const data = new FormData(form);
    return {
      endpoint: String(data.get("endpoint") ?? ""),
      region: String(data.get("region") ?? ""),
      bucket: String(data.get("bucket") ?? ""),
      accessKeyId: String(data.get("accessKeyId") ?? ""),
      secretAccessKey: String(data.get("secretAccessKey") ?? ""),
      forcePathStyle: data.get("forcePathStyle") === "on",
      enabled: data.get("enabled") === "on",
    };
  };

  const post = async (url: string, payload: unknown) => {
    const response = await fetch(url, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(payload),
    });
    return {
      response,
      body: (await response.json().catch(() => null)) as {
        ok?: boolean;
        message?: string;
      } | null,
    };
  };

  form.addEventListener("submit", async event => {
    event.preventDefault();
    show("保存中…", true);
    const { response, body } = await post("/api/admin/media/s3", readForm());
    if (response.ok) show(body?.message ?? "已保存。", true);
    else show(body?.message ?? "保存失败", false);
  });

  document.querySelector("#s3-test")?.addEventListener("click", async () => {
    show("测试中…", true);
    const { response, body } = await post(
      "/api/admin/media/s3/test",
      readForm()
    );
    if (response.ok) show(body?.message ?? "测试完成", body?.ok === true);
    else show(body?.message ?? "测试失败", false);
  });
</script>
