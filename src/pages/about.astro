---
import Site from "@/layouts/Site.astro";
import { db } from "@/lib/env";
import { getPage } from "@/lib/pages";
import { renderEntryBody } from "@/lib/entries";

const database = db();
const page = await getPage(database, "about");
if (!page) return new Response("页面不存在", { status: 404 });

// 和文章一样，HTML 在保存时算好；这里兜底一次，
// 免得直接改库的内容因为没有 body_html 就渲染成空白。
const html = page.body_html ?? (await renderEntryBody(database, page.body));
---

<Site title={page.title}>
  <h1 class="text-2xl font-semibold sm:text-3xl">{page.title}</h1>
  <div class="app-prose mt-8 max-w-none" set:html={html} />
</Site>
