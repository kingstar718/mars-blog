---
import Site from "@/layouts/Site.astro";
import PageEditor from "@/components/admin/PageEditor.astro";
import { homeStats, fillHomeStats } from "@/lib/homeStats";
import IconPencil from "@/assets/icons/IconPencil.svg";
import { getCollection } from "astro:content";

// 首页就是关于页：站点只有「关于 / 文章 / 随记」三处。
const about = (await getCollection("pages")).find(page => page.id === "about");
if (!about) return new Response(null, { status: 404 });
// 使用原有 Markdown 渲染结果，变量不决定正文的句式或格式。
if (!about.rendered) throw new Error("首页 Markdown 尚未渲染");
const values = homeStats(
  await getCollection("posts"),
  await getCollection("notes")
);
const html = fillHomeStats(about.rendered.html, values);
---

<Site mainClass="app-prose pt-8">
  <div class="group relative">
    <button
      type="button"
      data-admin
      id="edit-page"
      class="text-faint hover:text-accent absolute end-0 top-0 opacity-0 transition-opacity group-hover:opacity-100 focus-visible:opacity-100 max-md:opacity-70"
      title="编辑"
      aria-label="编辑"
    >
      <IconPencil class="size-4" />
    </button>
    <div data-page-body class="transition-opacity duration-150">
      <Fragment set:html={html} />
    </div>
    {
      /* 正文首段的上边距会外溢到容器外面，藏起来之后这段留白就没了，
        所以补回同样的一段——编辑器才落在原文那一行上 */
    }
    <div data-page-editor-slot data-page-slug="about" class="mt-[1.4em]"></div>
    <PageEditor />
  </div>
</Site>

<script>
  document
    .querySelector("#edit-page")
    ?.addEventListener("click", () =>
      dispatchEvent(new CustomEvent("page:edit"))
    );
</script>
