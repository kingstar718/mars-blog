---
import Site from "@/layouts/Site.astro";
import Timeline from "@/components/Timeline.astro";
import PostTimelineItem from "@/components/PostTimelineItem.astro";
import NoteTimelineItem from "@/components/NoteTimelineItem.astro";
import NoteImageZoom from "@/components/NoteImageZoom.astro";
import AdminControls from "@/components/AdminControls.astro";
import { listPublished } from "@/lib/db";
import { db } from "@/lib/env";
import { perPage } from "@/site";

// 首页：文章和短文混在同一条时间线上，按发布时间倒序。
// 不标注类型，只靠圆点实心/空心区分——旧站的做法，保持一致。
// 登录时草稿也进时间线（带「草稿」标记）：草稿的入口就是它自己的位置，
// 不再有单独的后台列表
const session = Astro.locals.session;
const { results } = await listPublished(
  db(),
  perPage.index,
  0,
  Boolean(session)
);
---

<Site mainClass="pt-8 pb-6">
  <Timeline>
    {
      results.map(entry =>
        entry.kind === "post" ? (
          <PostTimelineItem post={entry} />
        ) : (
          <NoteTimelineItem
            compact
            id={entry.id}
            pubDatetime={entry.pub_datetime}
            html={entry.body_html ?? ""}
          />
        )
      )
    }
  </Timeline>

  <nav class="mt-8 flex gap-6 text-sm">
    <a href="/posts" class="hover:text-accent">全部文章 →</a>
    <a href="/notes" class="hover:text-accent">全部短文 →</a>
  </nav>

  <NoteImageZoom />
  {Astro.locals.session && <AdminControls />}
</Site>
