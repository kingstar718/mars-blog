---
import Admin from "@/layouts/Admin.astro";
import { listAllForAdmin } from "@/lib/db";
import { formatDisplay } from "@/lib/datetime";
import { db } from "@/lib/env";

// 鉴权在 src/middleware.ts 统一做，这里能跑到就说明已登录
const { results } = await listAllForAdmin(db());

const posts = results.filter(entry => entry.kind === "post");
const notes = results.filter(entry => entry.kind === "note");
---

<Admin title="内容">
  <div class="mb-6 flex items-baseline gap-4 text-sm">
    <span class="text-neutral-500">
      {posts.length} 篇文章 · {notes.length} 条短文
    </span>
    <a href="/admin/edit?kind=post" class="text-neutral-900 underline">写文章</a
    >
    <a href="/admin/edit?kind=note" class="text-neutral-900 underline">写短文</a
    >
  </div>

  {results.length === 0 && <p class="text-sm text-neutral-500">还没有内容。</p>}

  <ul class="divide-y divide-neutral-200">
    {
      results.map(entry => (
        <li class="flex items-baseline gap-3 py-3">
          {entry.status === "draft" && (
            <span class="flex-none rounded bg-amber-100 px-1.5 py-0.5 text-xs text-amber-800">
              草稿
            </span>
          )}
          <a
            href={`/admin/edit?id=${entry.id}`}
            class="min-w-0 flex-1 truncate hover:underline"
          >
            {entry.kind === "post" ? entry.title : entry.body}
          </a>
          <time class="flex-none text-xs text-neutral-500">
            {formatDisplay(entry.pub_datetime)}
          </time>
        </li>
      ))
    }
  </ul>
</Admin>
