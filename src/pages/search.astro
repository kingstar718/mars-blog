---
import Site from "@/layouts/Site.astro";
import { getCollection } from "astro:content";
import { toSiteString } from "@/lib/entries";

// 构建期把文章和随记的内容放进一个索引，浏览器端纯 JS 过滤。
// 数据量（个人博客几百篇）完全扛得住，不依赖任何动态接口。
const posts = (await getCollection("posts")).filter(post => !post.data.draft);
const notes = (await getCollection("notes")).filter(note => !note.data.draft);
const index = [
  ...posts.map(post => ({
    href: `/posts/${post.id}`,
    title: post.data.title,
    pubDatetime: toSiteString(post.data.pubDatetime),
    body: post.body,
  })),
  ...notes.map(note => ({
    href: "/notes",
    title: `随记 ${toSiteString(note.data.pubDatetime).slice(0, 10)}`,
    pubDatetime: toSiteString(note.data.pubDatetime),
    body: note.body,
  })),
];
---

<Site title="搜索">
  <form method="GET" class="mb-8">
    <input
      type="search"
      name="q"
      placeholder="搜索文章和随记"
      autofocus
      class="border-border focus:border-accent w-full border-b bg-transparent py-2 outline-none"
    />
  </form>

  <p id="search-count" class="text-muted-foreground mb-6 text-sm" hidden></p>
  <ul id="search-results" class="space-y-6"></ul>
</Site>

<script
  is:inline
  type="application/json"
  id="search-index"
  set:html={JSON.stringify(index)}
/>

<script>
  import { formatDisplay, formatMachine } from "@/lib/datetime";
  import { splitTitle } from "@/lib/title";

  const input = document.querySelector<HTMLInputElement>('input[name="q"]');
  const list = document.querySelector<HTMLUListElement>("#search-results");
  const count = document.querySelector<HTMLParagraphElement>("#search-count");
  if (!input || !list || !count) throw new Error("搜索页结构缺失");
  const index = JSON.parse(
    document.getElementById("search-index")?.textContent ?? "[]"
  ) as { href: string; title: string; pubDatetime: string; body: string }[];

  const escapeHtml = (text: string) =>
    text.replace(
      /[&<>"']/g,
      c =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        })[c]!
    );

  /** 命中处前后各截一段，给搜索结果做上下文（与 v2 同一套） */
  const excerpt = (body: string, query: string, radius = 40) => {
    const at = body.toLowerCase().indexOf(query);
    if (at < 0) return body.slice(0, radius * 2);
    const start = Math.max(0, at - radius);
    const end = Math.min(body.length, at + query.length + radius);
    return `${start > 0 ? "…" : ""}${body.slice(start, end)}${
      end < body.length ? "…" : ""
    }`;
  };

  const titleHtml = (item: { href: string; title: string }) => {
    if (item.href.startsWith("/posts")) {
      const { base, tags } = splitTitle(item.title);
      return `<h2 class="mt-1 text-lg font-medium">
        <a href="${item.href}" class="hover:text-accent">${escapeHtml(base)}${tags
          .map(
            tag =>
              ` <span class="text-faint text-[0.7em] font-normal">${escapeHtml(
                tag
              )}</span>`
          )
          .join("")}</a>
      </h2>`;
    }
    return `<a href="/notes" class="hover:text-accent text-sm">随记</a>`;
  };

  const render = (query: string) => {
    const q = query.trim().toLowerCase();
    const results = q
      ? index.filter(item =>
          `${item.title} ${item.body}`.toLowerCase().includes(q)
        )
      : [];
    count.hidden = !q;
    count.textContent = q ? `「${query.trim()}」找到 ${results.length} 条` : "";
    list.innerHTML = results.length
      ? results
          .map(item => {
            const body = excerpt(item.body.replace(/\s+/g, " "), q);
            return `
              <li>
                <div class="text-faint flex items-center">
                  <time class="text-sm" datetime="${formatMachine(
                    item.pubDatetime
                  )}">${formatDisplay(item.pubDatetime)}</time>
                </div>
                ${titleHtml(item)}
                <p class="text-muted-foreground mt-1 text-sm leading-relaxed">${escapeHtml(
                  body
                )}</p>
              </li>`;
          })
          .join("")
      : q
        ? `<li class="text-muted-foreground text-sm">没有找到「${query}」。</li>`
        : "";
  };

  input.addEventListener("input", () => render(input.value));
  if (new URLSearchParams(location.search).get("q")) {
    input.value = new URLSearchParams(location.search).get("q") ?? "";
    render(input.value);
  }
</script>
