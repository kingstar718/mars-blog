---
import Site from "@/layouts/Site.astro";
import AdminControls from "@/components/AdminControls.astro";
import PostRow from "@/components/PostRow.astro";
import ListFooter from "@/components/ListFooter.astro";
import Pagination from "@/components/Pagination.astro";
import TimelineStats from "@/components/TimelineStats.astro";
import { countByYear, countPublished, listPublishedByKind } from "@/lib/db";
import { db } from "@/lib/env";
import { perPage } from "@/site";

// 分页从路径段取：/posts 是第一页，/posts/2 起才有页码。
// 页码非法（0、负数、超出范围）一律回落到第一页，不返回 404——
// 列表页的地址常被手改，给个能看的页面比报错友好。
const raw = Number(Astro.params.page ?? 1);
const database = db();
const drafts = Boolean(Astro.locals.session);
const total = (await countPublished(database, "post", drafts))?.n ?? 0;
const totalPages = Math.max(1, Math.ceil(total / perPage.posts));
const current =
  Number.isInteger(raw) && raw >= 1 && raw <= totalPages ? raw : 1;

const { results } = await listPublishedByKind(
  database,
  "post",
  perPage.posts,
  (current - 1) * perPage.posts,
  drafts
);
const { results: years } = await countByYear(database, "post");

// 按年分组：年份做小标题，行里只留月日。
// 分页之后每页顶多跨两三个年份，分组在页内做就够，不必按年分页。
const grouped = results.reduce<[string, typeof results][]>((groups, post) => {
  const year = post.pub_datetime.slice(0, 4);
  const last = groups.at(-1);
  if (last?.[0] === year) last[1].push(post);
  else groups.push([year, [post]]);
  return groups;
}, []);
---

<Site title="文章">
  {Astro.locals.session && <AdminControls create="post" />}
  {
    grouped.map(([year, posts]) => (
      <section class="mb-8 last:mb-0">
        {/* 年份轻到几乎只是个记号：全站只有文章标题一处用粗体 */}
        <h2 class="text-faint mb-1 text-sm tabular-nums">{year}</h2>
        {posts.map(post => (
          <PostRow post={post} />
        ))}
      </section>
    ))
  }

  <ListFooter>
    <Pagination current={current} total={totalPages} base="/posts" />
    <TimelineStats
      total={total}
      unit="篇"
      groups={years.map(row => [row.year, row.n])}
    />
  </ListFooter>
</Site>
