---
import Site from "@/layouts/Site.astro";
import AdminControls from "@/components/AdminControls.astro";
import PostRow from "@/components/PostRow.astro";
import ListFooter from "@/components/ListFooter.astro";
import Pagination from "@/components/Pagination.astro";
import TimelineStats from "@/components/TimelineStats.astro";
import { countByYear, countPublished, listPublishedByKind } from "@/lib/db";
import { db } from "@/lib/env";
import { perPage } from "@/site";

// 分页从路径段取：/posts 是第一页，/posts/page/2 起才有页码。
// 垫一个 page 段是必须的——/posts/2 会被 [id].astro 抢走渲染成文章，
// 单段动态路由的优先级高于 [...page]（理由见 Pagination.astro）。
const raw = Number(Astro.params.page?.replace(/^page\//, "") ?? 1);
const database = db();
const drafts = Boolean(Astro.locals.session);

// 页码非法（0、负数、拼错）先归到第一页，好让下面那条查询能一起发出去；
// 「超出范围」要等总数回来才知道，在后面兜。
const wanted = Number.isInteger(raw) && raw >= 1 ? raw : 1;

// 三条查询互不依赖，一起发——串行的话是三个来回，
// 每条本身只有几毫秒，来回才是大头。
// 列表按 wanted 乐观地取：除非地址是手改的，这一次就是对的。
const [totalRow, yearRows, firstTry] = await Promise.all([
  countPublished(database, "post", drafts),
  countByYear(database, "post"),
  listPublishedByKind(
    database,
    "post",
    perPage.posts,
    (wanted - 1) * perPage.posts,
    drafts
  ),
]);

const total = totalRow?.n ?? 0;
const totalPages = Math.max(1, Math.ceil(total / perPage.posts));
// 页码超出范围一律回落到第一页，不返回 404——
// 列表页的地址常被手改，给个能看的页面比报错友好
const current = wanted <= totalPages ? wanted : 1;
const { results } =
  current === wanted
    ? firstTry
    : await listPublishedByKind(database, "post", perPage.posts, 0, drafts);
const years = yearRows.results;

// 按年分组：年份做小标题，行里只留月日。
// 分页之后每页顶多跨两三个年份，分组在页内做就够，不必按年分页。
const grouped = results.reduce<[string, typeof results][]>((groups, post) => {
  const year = post.pub_datetime.slice(0, 4);
  const last = groups.at(-1);
  if (last?.[0] === year) last[1].push(post);
  else groups.push([year, [post]]);
  return groups;
}, []);
---

<Site title="文章">
  {Astro.locals.session && <AdminControls create="post" />}
  {
    grouped.map(([year, posts]) => (
      <section class="mb-8 last:mb-0">
        {/* 年份轻到几乎只是个记号：全站只有文章标题一处用粗体 */}
        <h2 class="text-faint mb-1 text-sm tabular-nums">{year}</h2>
        {posts.map(post => (
          <PostRow post={post} />
        ))}
      </section>
    ))
  }

  <ListFooter>
    <Pagination current={current} total={totalPages} base="/posts" />
    <TimelineStats
      total={total}
      unit="篇"
      groups={years.map(row => [row.year, row.n])}
    />
  </ListFooter>
</Site>
