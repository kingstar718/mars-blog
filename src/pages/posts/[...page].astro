---
import Site from "@/layouts/Site.astro";
import AdminControls from "@/components/AdminControls.astro";
import EntryTitle from "@/components/EntryTitle.astro";
import ListFooter from "@/components/ListFooter.astro";
import Pagination from "@/components/Pagination.astro";
import TimelineStats from "@/components/TimelineStats.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { groupByYear, toSiteString } from "@/lib/entries";
import { perPage } from "@/site";

export async function getStaticPaths() {
  const posts = (await getCollection("posts"))
    .filter(post => !post.data.draft)
    .sort(
      (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
    );
  const totalPages = Math.max(1, Math.ceil(posts.length / perPage.posts));
  const years = posts.reduce<[string, number][]>((acc, post) => {
    const year = String(post.data.pubDatetime.getFullYear());
    const last = acc.at(-1);
    if (last?.[0] === year) last[1] += 1;
    else acc.push([year, 1]);
    return acc;
  }, []);
  return Array.from({ length: totalPages }, (_, index) => {
    const page = index + 1;
    return {
      params: { page: page === 1 ? undefined : `page/${page}` },
      props: {
        current: page,
        totalPages,
        total: posts.length,
        years,
        posts: posts.slice((page - 1) * perPage.posts, page * perPage.posts),
      },
    };
  });
}

const { current, totalPages, total, years, posts } = Astro.props as {
  current: number;
  totalPages: number;
  total: number;
  years: [string, number][];
  posts: CollectionEntry<"posts">[];
};

const grouped = groupByYear(posts);
---

<Site title="文章">
  <AdminControls create="post" />
  {
    grouped.map(([year, yearPosts]) => (
      <section class="mb-8 last:mb-0">
        <h2 class="text-faint mb-1 text-sm tabular-nums">{year}</h2>
        {yearPosts.map(post => (
          <div class="flex items-baseline gap-4 py-1.5">
            <time
              class="text-faint w-12 shrink-0 text-sm tabular-nums"
              datetime={toSiteString(post.data.pubDatetime)}
            >
              {toSiteString(post.data.pubDatetime).slice(5, 10)}
            </time>
            <a
              href={`/posts/${post.id}`}
              class="hover:text-accent decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline"
            >
              <EntryTitle title={post.data.title} />
            </a>
          </div>
        ))}
      </section>
    ))
  }

  <ListFooter>
    <Pagination current={current} total={totalPages} base="/posts" />
    <TimelineStats total={total} unit="篇" groups={years} />
  </ListFooter>
</Site>
