{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mars-blog",
  "compatibility_date": "2026-07-29",
  // Astro 的 Cloudflare adapter 需要 Node 兼容层
  "compatibility_flags": ["nodejs_compat"],
  // 不要写 main / assets：adapter v14 走 @cloudflare/vite-plugin，
  // 入口和静态资源由它在构建时生成，这里写死会让构建在同步阶段就失败。
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mars-blog",
      "database_id": "d269a4d4-4e88-42ab-93ac-16632918494f",
      "migrations_dir": "migrations",
    },
  ],
  // 绑定名不能叫 IMAGES——adapter 会把它当成 Cloudflare Images 服务绑定。
  //   pnpm exec wrangler r2 bucket create mars-blog-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mars-blog-media",
    },
  ],
  // 机密不写在这里，用 wrangler secret put 设置：
  //   ADMIN_PASSWORD_HASH  —— 站长口令的 PBKDF2 哈希，用 scripts/hash-password.mjs 生成
  //   SESSION_SECRET       —— 会话 cookie 签名密钥（换掉它等于让所有会话立刻失效）
  //   EXPORT_TOKEN         —— 每日备份拉 /api/export 用
}
